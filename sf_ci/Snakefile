import os
import yaml
import numpy as np
import pandas as pd
from sf_conditions.helper_functions import generate_image_list, find_start_date

# Read in Parameters from YAML
with open("config/sf_current_conditions.yaml", "r") as file:
    params = yaml.safe_load(file)

# Load metadata and generate list of files to make
metadata = pd.read_csv(params["s3_url_prefix"] + "metadata/sf_file_metadata.csv", dtype=str, keep_default_na=False)

# refresh all image files
metadata.iloc[-1, 1:] = 'NA'

# Set default date if nothing is specified
date_of_interest = config.get("date", "2026-03-03")

# Get the image and parquet lists for pipeline
(images_to_download,
images_to_generate,
parquets_for_image_generation,
layout_for_image_generation,
static_images_to_generate,
images_for_static_image_generation,
layout_for_static_image_generation,
video_frame_lists,
video_names,
parquets_to_download_or_generate,
parquets_to_download,
date_dict
) = generate_image_list(
    date_of_interest, params["image_prefix"], params["video_prefix"], params["parquet_prefix"], params["layouts"], params["video_intervals"], metadata
)

# Get list of background images (non-static)
background_images_to_generate = []
for layout in params["layouts"].keys():
    if params["layouts"][layout]["static"] == False:
        background_images_to_generate += ["images/sf-" + params["layouts"][layout]["prefix"][:-1] + "-background.webp"]

# set final intended output
rule all:
    input:
        images_to_generate,
        video_names,
        params["dates_file"],
        background_images_to_generate

# make date json
rule make_date_json:
    params:
        date_dict = date_dict
    output:
        output = params["dates_file"]
    script:
        "sf_conditions/process/make_json.py"

########################################
#############GEOMETRY  DATA#############
########################################

# gather the state census boundaries
rule gather_census_data:
    params:
        resolution = params["census_data"]["resolution"],
        year = params["census_data"]["year"]
    output:
        conus_geojson = "data/conus.geojson",
        ak_geojson = "data/ak.geojson",
        hi_geojson = "data/hi.geojson",
        prvi_geojson = "data/prvi.geojson",
        gump_geojson = "data/gump.geojson",
        as_geojson = "data/as.geojson",
    script:
        "sf_conditions/fetch/get_boundaries.py"

# simplify the different census boundaries
for geometry in params["geometries"].keys():
    rule:
        name:
            "simplify_census_data_desktop: " + geometry
        params:
            desktop_simplify = params["geometries"][geometry]["desktop"],
            mobile_simplify = params["geometries"][geometry]["mobile"]
        input:
            infile = params["geometries"][geometry]["geojson"]
        output:
            desktop_outfile = params["geometries"][geometry]["geojson"][:-8] + "_simplified_desktop.geojson",
            mobile_outfile = params["geometries"][geometry]["geojson"][:-8] + "_simplified_mobile.geojson"
        shell:
            r'''
            npx mapshaper {input.infile} -simplify {params.desktop_simplify}% -o {output.desktop_outfile}
            npx mapshaper {input.infile} -simplify {params.mobile_simplify}% -o {output.mobile_outfile}
            '''

########################################
#############DATA  DOWNLOAD#############
########################################

# download usgs logo
rule download_usgs_logo:
    params:
        s3_url_prefix = params["s3_url_prefix"],
        folder = "logos"
    output:
        s3_file = "logos/usgs_logo_black.png"
    script:
        "sf_conditions/fetch/get_s3.py"

# download legend
rule download_legend:
    params:
        s3_url_prefix = params["s3_url_prefix"],
        folder = "legends"
    output:
        s3_file = "legends/sf-static-legend.png"
    script:
        "sf_conditions/fetch/get_s3.py"

# download images that are available for longest interval
for image_file in images_to_download:
    rule:
        name:
            "image_download: " + image_file
        params:
            s3_url_prefix = params["s3_url_prefix"],
            folder = "images"
        output:
            s3_file = image_file
        script:
            "sf_conditions/fetch/get_s3.py"

# download streamflow data coverage data
rule download_coverage:
    params:
        s3_url_prefix = params["s3_url_prefix"],
        folder = "metadata"
    output:
        s3_file = params["coverage_file"]
    script:
        "sf_conditions/fetch/get_s3.py"

# download or generate categorization parquet files
for i, parquet_file in enumerate(parquets_to_download_or_generate):
    rule:
        name:
            "parquet_download_generate: " + parquet_file
        params:
            s3_url_prefix = params["s3_url_prefix"],
            s3_url_file = parquets_to_download[i],
            folder = "data"
        input:
            coverage_parquet = params["coverage_file"]
        output:
            parquet_file = parquet_file
        script:
            "sf_conditions/process/sf_categorize_inst_values.py"


########################################
############IMAGE GENERATION############
########################################

# Create isolated images of markers for legend
rule make_legend_elements:
    params:
        marker_params = params["marker_params"],
        dpi = 4000
    output:
        "images/_legend/No-data-marker.png",
        ["images/_legend/" + label.replace(" ", "-") + "-marker.png" for label in params["marker_params"]["label"]],
        "images/_legend/No-data-marker.svg",
        ["images/_legend/" + label.replace(" ", "-") + "-marker.svg" for label in params["marker_params"]["label"]]
    script:
            "sf_conditions/plot/plot_legend_elements.py"

for layout in params["layouts"].keys():
    if params["layouts"][layout]["static"] == False:
        # Create shadow background for each layout
        rule:
            name:
                "make_shadow_plot_" + layout
            params:
                figure_params = params["figure_params"],
                state_params = params["state_params"],
                layout_params = params["layouts"][layout]
            input:
                reference_geojson = params["layouts"][layout]["geojson"]
            output:
                shadow_image_file = "images/sf-" + params["layouts"][layout]["prefix"][:-1] + "-shadow.png"
            script:
                "sf_conditions/plot/plot_shadow.py"

        # Create background for each layout
        rule:
            name:
                "make_background_plot_" + layout
            params:
                figure_params = params["figure_params"],
                marker_params = params["marker_params"],
                state_params = params["state_params"],
                layout_params = params["layouts"][layout]
            input:
                reference_geojson = params["layouts"][layout]["geojson"],
                shadow_image_file = "images/sf-" + params["layouts"][layout]["prefix"][:-1] + "-shadow.png"
            output:
                background_image_file = "images/sf-" + params["layouts"][layout]["prefix"][:-1] + "-background.webp"
            script:
                "sf_conditions/plot/plot_background.py"

# Create sf current conditions plots for the given list of dates and layouts
for i, parquet_file in enumerate(parquets_for_image_generation[:]):
    rule:
        name: 
            "image_make: " + images_to_generate[i]
        params:
            figure_params = params["figure_params"],
            marker_params = params["marker_params"],
            layout_params = params["layouts"][layout_for_image_generation[i]]
        input:
            parquet_file = parquet_file,
            reference_geojson = params["layouts"][layout_for_image_generation[i]]["geojson"]
        output:
            image_file = images_to_generate[i]
        script:
            "sf_conditions/plot/plot_sf.py"

# Create static png for each layout that requires it
for i, image_file in enumerate(images_for_static_image_generation[:]):
    rule:
        name:
            "image_make: " + static_images_to_generate[i]
        params:
            figure_params = params["figure_params"],
            layout_params = params["layouts"][layout]
        input:
            background_image_file = "images/sf-" + params["layouts"][layout]["source_prefix"][:-1] + "-background.webp",
            foreground_image_file = image_file,
            usgs_image_file = "logos/usgs_logo_black.png",
            legend_image_file = "legends/sf-static-legend.png"
        output:
            static_image_file = static_images_to_generate[i]
        script:
            "sf_conditions/plot/plot_static.py"

########################################
############VIDEO GENERATION############
########################################
for i, video_name in enumerate(video_names):
    # create image list text file with durations for movie
    rule:
        name:
            "animation list:" + video_name
        params:
            framerate = params["movie_params"]["framerate"],
        input:
            image_list = video_frame_lists[i][:] 
        output:
            frame_list = "temp/" + video_name[7:-4] + ".txt"
        script:
            "sf_conditions/plot/generate_frame_list.py"
            
    # create a movie from the list of generated images
    rule:
        name:
            "animate:" + video_name
        input:
            image_list = video_frame_lists[i][:],
            frame_list = "temp/" + video_name[7:-4] + ".txt"
        output:
            outfile = video_name
        shell:
            r'''
            ffmpeg -y \
            -safe 0 -f concat -i {input.frame_list} \
            -vsync vfr -pix_fmt yuv420p -vcodec libx264 \
            {output.outfile}
            '''
